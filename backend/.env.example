# ========================================
# AI API 설정
# ========================================

# 사용할 AI 선택: "claude" 또는 "gemini"
# claude: Anthropic Claude API (유료, 더 정확함)
# gemini: Google Gemini API (무료 할당량 있음, 초보자 추천!)
API_PROVIDER=gemini

# ========================================
# Anthropic Claude API Key
# ========================================
# Claude를 사용하려면 아래 키가 필요합니다
# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ========================================
# Google Gemini API Key
# ========================================
# Gemini를 사용하려면 아래 키가 필요합니다 (무료!)
# 발급: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
